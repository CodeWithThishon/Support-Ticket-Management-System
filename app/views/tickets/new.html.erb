<h1>Create Support Ticket</h1>

<%= form_with model: @ticket, local: true do |f| %>
  <% if @ticket.errors.any? %>
    <div>
      <h3>Please correct these errors:</h3>
      <ul>
        <% @ticket.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title %>
    <%= f.text_field :title, required: true %>
  </div>

  <div>
    <%= f.label :description %>
    <%= f.text_area :description, required: true %>
  </div>

  <div>
    <%= f.label :priority %>
    <%= f.select :priority,
                 Ticket::PRIORITIES.map { |priority| [priority.titleize, priority] },
                 selected: "medium" %>
  </div>

  <%= f.submit "Create Ticket" %>
<% end %>

<% if logged_in? %>
  <% if current_user.role == "admin" %>
    <h1>Admin Dashboard</h1>
<p>Total Tickets : <%=@total_tickets %></p>
    <p>Unassigned Tickets: <%= @unassigned_tickets %></p>

  <% elsif current_user.role == "engineer" %>
    <h1>Engineer Dashboard</h1>
    <p>My Assigned Tickets: <%= @total_tickets %></p>

  <% elsif current_user.role == "requester" %>
    <h1>My Support Dashboard</h1>
    <p>My Tickets: <%= @total_tickets %></p>
  <% end %>

  <div class="dashboard-stats">
    <p>Open: <%= @open_tickets %></p>
    <p>In Progress: <%= @in_progress_tickets %></p>
    <p>Resolved: <%= @resolved_tickets %></p>
    <p>Closed: <%= @closed_tickets %></p>
  </div>

  <% else %>

  <section class="hero">
    <h1>Support Made Simple</h1>

    <p>
      Manage support requests, track progress, and resolve issues
      efficiently with our Support Ticket Management System.
    </p>

    <%= link_to "Log In", login_path, class: "btn btn-primary" %>
  </section>

  <section class="features">
    <div class="feature-card">
      <h2>Track Tickets</h2>
      <p>Monitor support requests and their status in one place.</p>
    </div>

    <div class="feature-card">
      <h2>Manage Assignments</h2>
      <p>Help engineers focus on their assigned support tickets.</p>
    </div>

    <div class="feature-card">
      <h2>Track Progress</h2>
      <p>Follow ticket updates from creation through resolution.</p>
    </div>
  </section>

<% end %>

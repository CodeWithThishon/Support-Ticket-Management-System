<!DOCTYPE html>
<html>
  <head>
    <title>SupportTicketManagementSystem</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <div class="container">
      <% flash.each do |type, message| %>
        <% alert_class = { "success" => "success", "danger" => "danger", "alert" => "warning", "notice" => "info" }.fetch(type.to_s, "info") %>
        <div class="alert alert-<%= alert_class %>" role="alert">
          <%= message %>
        </div>
      <% end %>

    <%= yield %>
    </div>
  </body>
</html>

<h1>Log in</h1>

<%= form_with url: login_path, scope: :session, local: true do |f| %>
  <div>
    <%= f.label :email %>
    <%= f.email_field :email, required: true %>
  </div>

  <div>
    <%= f.label :password %>
    <%= f.password_field :password, required: true %>
  </div>

  <div>
    <%= f.submit "Log in" %>
  </div>
<% end %>

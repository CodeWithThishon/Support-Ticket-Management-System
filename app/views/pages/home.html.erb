
<h1>Support Ticket Dashboard</h1>

<div>
  <h3>Total Tickets</h3>
  <p><%= @total_tickets %></p>
</div>

<div>
  <h3>Open Tickets</h3>
  <p><%= @open_tickets %></p>
</div>

<div>
  <h3>In Progress Tickets</h3>
  <p><%= @in_progress_tickets %></p>
</div>

<div>
  <h3>Resolved Tickets</h3>
  <p><%= @resolved_tickets %></p>
</div>

<div>
  <h3>Closed Tickets</h3>
  <p><%= @closed_tickets %></p>
</div>

<div>
  <h3>Unassigned Tickets</h3>
  <p><%= @unassigned_tickets %></p>
</div>

<h2>Tickets Per Engineer</h2>

<% @engineer_ticket_counts.each do |(engineer_id, engineer_name), count| %>
  <div>
    <p><%= engineer_name %>: <%= count %> tickets</p>
  </div>
<% end %>
<%= button_to "Log out", logout_path, method: :delete %>